<Window x:Class="AudioTranscriber.App.ShareWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:AudioTranscriber.App.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Compartir — Audio Transcriber" Height="620" Width="480"
        MinHeight="420" MinWidth="400"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Bg}" FontFamily="Segoe UI" FontSize="14"
        Foreground="{DynamicResource TextPrimary}">

    <!-- Team Sharing slice 1b, Phase 17 ("UI de compartir proyectos"): invitar por email, ver/
         cambiar rol de miembros, sacarlos, y ver/cancelar invitaciones pendientes enviadas para
         este proyecto. Mismo WindowChrome/TitleBar que InvitesWindow/BrainWindow. -->

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36"
                             ResizeBorderThickness="6"
                             GlassFrameThickness="0"
                             CornerRadius="0"
                             UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <controls:TitleBar x:Name="WindowTitleBar" Grid.Row="0" TitleText="Compartir"/>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="Compartir proyecto" Style="{StaticResource TitleText}"/>
                    <TextBlock Text="Invitá a alguien por email, o gestioná a quienes ya tienen acceso a este proyecto."
                               Style="{StaticResource CaptionText}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>

                <!-- ============= Invitar por email ============= -->
                <Border Grid.Row="1" Style="{StaticResource Card}" Background="{DynamicResource SurfaceAlt}"
                        Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBox Style="{StaticResource InputBox}" Width="220" Height="32"
                                     VerticalContentAlignment="Center"
                                     Text="{Binding NewMemberEmail, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="Email de la persona a invitar"
                                     ToolTip="Email de la persona a invitar (tiene que tener cuenta en el producto)."/>
                            <ComboBox Margin="6,0,0,0" Width="100" Height="32" VerticalContentAlignment="Center"
                                      SelectedValuePath="Tag" SelectedValue="{Binding NewMemberRole}">
                                <ComboBoxItem Content="Admin" Tag="admin"/>
                                <ComboBoxItem Content="Editor" Tag="editor" IsSelected="True"/>
                                <ComboBoxItem Content="Viewer" Tag="viewer"/>
                            </ComboBox>
                            <Button Content="Invitar" Style="{StaticResource PrimaryButton}"
                                    Margin="6,0,0,0" Padding="10,4" VerticalAlignment="Center"
                                    Command="{Binding InviteCommand}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding InviteErrorMessage}" Foreground="{DynamicResource Danger}"
                                   TextWrapping="Wrap" FontSize="11" Margin="0,6,0,0"
                                   Visibility="{Binding InviteErrorMessage, Converter={StaticResource CountToVisibility}, ConverterParameter=Invert}"/>
                    </StackPanel>
                </Border>

                <!-- ============= Miembros + invitaciones pendientes ============= -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Miembros" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6"
                                   Foreground="{DynamicResource TextSecondary}"/>
                        <ItemsControl ItemsSource="{Binding Members}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" Padding="10" Margin="0,0,0,8"
                                            Background="{DynamicResource SurfaceAlt}">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Email}" FontSize="13"
                                                           FontWeight="SemiBold" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextPrimary}"/>
                                                <!-- El dueño se muestra sin controles: comodidad de UI, no
                                                     seguridad (el servidor igual lo rechaza), ver ShareViewModel. -->
                                                <TextBlock Grid.Column="1" Text="Dueño" FontSize="11"
                                                           Foreground="{DynamicResource TextMuted}"
                                                           VerticalAlignment="Center"
                                                           Visibility="{Binding IsOwner, Converter={StaticResource BoolToVisibility}}"/>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolean}}"
                                                            Visibility="{Binding IsOwner, Converter={StaticResource InverseBoolToVisibility}}">
                                                    <ComboBox Width="90" Height="28" FontSize="11"
                                                              VerticalContentAlignment="Center"
                                                              SelectedValuePath="Tag" SelectedValue="{Binding SelectedRole}">
                                                        <ComboBoxItem Content="Admin" Tag="admin"/>
                                                        <ComboBoxItem Content="Editor" Tag="editor"/>
                                                        <ComboBoxItem Content="Viewer" Tag="viewer"/>
                                                    </ComboBox>
                                                    <Button Content="Guardar" Style="{StaticResource SecondaryButton}"
                                                            Padding="8,3" FontSize="11" Margin="4,0,0,0"
                                                            Command="{Binding DataContext.ChangeRoleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"/>
                                                    <Button Content="Quitar" Style="{StaticResource DangerButton}"
                                                            Padding="8,3" FontSize="11" Margin="4,0,0,0"
                                                            Command="{Binding DataContext.RemoveMemberCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"/>
                                                </StackPanel>
                                            </Grid>
                                            <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource Danger}"
                                                       TextWrapping="Wrap" FontSize="11" Margin="0,4,0,0"
                                                       Visibility="{Binding ErrorMessage, Converter={StaticResource CountToVisibility}, ConverterParameter=Invert}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="Invitaciones pendientes" FontWeight="SemiBold" FontSize="12"
                                   Margin="0,10,0,6" Foreground="{DynamicResource TextSecondary}"
                                   Visibility="{Binding SentInvites.Count, Converter={StaticResource CountToVisibility}, ConverterParameter=Invert}"/>
                        <ItemsControl ItemsSource="{Binding SentInvites}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" Padding="10" Margin="0,0,0,8"
                                            Background="{DynamicResource SurfaceAlt}">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" FontSize="12" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextPrimary}">
                                                    <Run Text="Rol: "/><Run Text="{Binding Role, Mode=OneWay}"/>
                                                    <Run Text=" · esperando respuesta"/>
                                                </TextBlock>
                                                <Button Grid.Column="1" Content="Cancelar" Style="{StaticResource SecondaryButton}"
                                                        Padding="8,3" FontSize="11" VerticalAlignment="Center"
                                                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolean}}"
                                                        Command="{Binding DataContext.CancelInviteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"/>
                                            </Grid>
                                            <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource Danger}"
                                                       TextWrapping="Wrap" FontSize="11" Margin="0,4,0,0"
                                                       Visibility="{Binding ErrorMessage, Converter={StaticResource CountToVisibility}, ConverterParameter=Invert}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <Grid Grid.Row="3" Margin="0,10,0,0">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource Danger}"
                               TextWrapping="Wrap" FontSize="12"
                               Visibility="{Binding ErrorMessage, Converter={StaticResource CountToVisibility}, ConverterParameter=Invert}"/>
                    <Button Content="Actualizar" Style="{StaticResource SecondaryButton}"
                            HorizontalAlignment="Right" Command="{Binding LoadCommand}"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
