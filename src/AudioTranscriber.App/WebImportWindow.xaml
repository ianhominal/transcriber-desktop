<Window x:Class="AudioTranscriber.App.WebImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:AudioTranscriber.App.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Transcribir desde una URL — Audio Transcriber" Height="560" Width="520"
        MinHeight="420" MinWidth="440"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Bg}" FontFamily="Segoe UI" FontSize="14"
        Foreground="{DynamicResource TextPrimary}">

    <!-- "Transcribir desde una URL": pegar una URL (YouTube, podcast, etc.), analizarla con yt-dlp
         sin descargar nada, elegir uno o más elementos de la lista, y descargarlos: entran al
         proyecto elegido por el MISMO camino que "Cargar archivo(s)"/arrastrar y soltar
         (ver WebImportViewModel y MainViewModel.ImportWebDownloadedFile). Mismo WindowChrome que
         ShareWindow/BrainWindow. -->

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36"
                             ResizeBorderThickness="6"
                             GlassFrameThickness="0"
                             CornerRadius="0"
                             UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <controls:TitleBar x:Name="WindowTitleBar" Grid.Row="0" TitleText="Transcribir desde una URL"/>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="Transcribir desde una URL" Style="{StaticResource TitleText}"/>
                    <TextBlock Text="Pegá el link de un video, audio o playlist (YouTube y otros sitios soportados por yt-dlp)."
                               Style="{StaticResource CaptionText}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>

                <!-- ============= URL + Analizar ============= -->
                <Grid Grid.Row="1" Margin="0,0,0,10" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolean}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" Style="{StaticResource InputBox}"
                             Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="URL a analizar"
                             ToolTip="Pegá acá la URL del video, audio o playlist."/>
                    <Button Grid.Column="1" Content="Analizar" Style="{StaticResource PrimaryButton}"
                            Margin="6,0,0,0" Padding="12,6"
                            Command="{Binding AnalyzeCommand}"/>
                </Grid>

                <!-- ============= Lista de resultados ============= -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{Binding PlaylistTitle, StringFormat='Playlist: {0}'}"
                                   FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6"
                                   Foreground="{DynamicResource TextSecondary}"
                                   Visibility="{Binding PlaylistTitle, Converter={StaticResource CountToVisibility}, ConverterParameter=Invert}"/>

                        <ItemsControl ItemsSource="{Binding Items}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" Padding="8,6" Margin="0,0,0,6"
                                            Background="{DynamicResource SurfaceAlt}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <CheckBox Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0"
                                                      IsChecked="{Binding IsSelected}"
                                                      AutomationProperties.Name="{Binding Title}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="13"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource TextPrimary}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding DurationText}" FontSize="12"
                                                       VerticalAlignment="Center" Margin="8,0,0,0"
                                                       Foreground="{DynamicResource TextMuted}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- ============= Progreso ============= -->
                <StackPanel Grid.Row="3" Margin="0,10,0,0"
                            Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVisibility}}">
                    <ProgressBar Height="6" Minimum="0" Maximum="100" Value="{Binding ProgressPercent, Mode=OneWay}"/>
                </StackPanel>

                <!-- ============= Estado + botones ============= -->
                <Grid Grid.Row="4" Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{Binding StatusMessage}"
                               Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,0,0,10"/>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancelar descarga" Style="{StaticResource SecondaryButton}"
                                Padding="10,6" Margin="0,0,6,0"
                                Command="{Binding CancelCommand}"/>
                        <Button Content="Descargar y transcribir" Style="{StaticResource PrimaryButton}"
                                Padding="10,6"
                                Command="{Binding ConfirmCommand}"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
