<Window x:Class="AudioTranscriber.App.InvitesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:AudioTranscriber.App.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Invitaciones — Audio Transcriber" Height="480" Width="440"
        MinHeight="320" MinWidth="360"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Bg}" FontFamily="Segoe UI" FontSize="14"
        Foreground="{DynamicResource TextPrimary}">

    <!-- Team Sharing slice 1b, Phase 16 (design ADR-13 "paridad de invitaciones pendientes en los
         dos clientes"): ver y resolver (aceptar/rechazar) las invitaciones que el usuario recibió,
         mismo contrato de servidor que la web (InvitesApiClient, Phase 9.5/9.3). Mismo
         WindowChrome/TitleBar que el resto de las ventanas "Híbrido nativo" (BrainWindow/FormatosWindow). -->

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36"
                             ResizeBorderThickness="6"
                             GlassFrameThickness="0"
                             CornerRadius="0"
                             UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <controls:TitleBar x:Name="WindowTitleBar" Grid.Row="0" TitleText="Invitaciones"/>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="Invitaciones pendientes" Style="{StaticResource TitleText}"/>
                    <TextBlock Text="Proyectos a los que te invitaron. Aceptá para sumarte o rechazá para descartar la invitación."
                               Style="{StaticResource CaptionText}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>

                <Grid Grid.Row="1">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                IsHitTestVisible="False" MaxWidth="280"
                                Visibility="{Binding Invites.Count, Converter={StaticResource CountToVisibility}}">
                        <TextBlock Text="No tenés invitaciones pendientes" HorizontalAlignment="Center"
                                   FontWeight="SemiBold" FontSize="13" Margin="0,8,0,0"
                                   Foreground="{DynamicResource TextSecondary}"/>
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Invites}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" Padding="10" Margin="0,0,0,8"
                                            Background="{DynamicResource SurfaceAlt}">
                                        <StackPanel>
                                            <TextBlock FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimary}">
                                                <Run Text="Proyecto "/><Run Text="{Binding ProjectId, Mode=OneWay}"/>
                                            </TextBlock>
                                            <TextBlock FontSize="11" Foreground="{DynamicResource TextMuted}"
                                                       Margin="0,2,0,0">
                                                <Run Text="Rol: "/><Run Text="{Binding Role, Mode=OneWay}"/>
                                            </TextBlock>
                                            <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource Danger}"
                                                       TextWrapping="Wrap" FontSize="11" Margin="0,4,0,0"
                                                       Visibility="{Binding ErrorMessage, Converter={StaticResource CountToVisibility}, ConverterParameter=Invert}"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolean}}">
                                                <Button Content="Aceptar" Style="{StaticResource PrimaryButton}"
                                                        Padding="10,4" FontSize="11" Margin="0,0,6,0"
                                                        Command="{Binding DataContext.AcceptCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Content="Rechazar" Style="{StaticResource SecondaryButton}"
                                                        Padding="10,4" FontSize="11"
                                                        Command="{Binding DataContext.RejectCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <Grid Grid.Row="2" Margin="0,10,0,0">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource Danger}"
                               TextWrapping="Wrap" FontSize="12"
                               Visibility="{Binding ErrorMessage, Converter={StaticResource CountToVisibility}, ConverterParameter=Invert}"/>
                    <Button Content="Actualizar" Style="{StaticResource SecondaryButton}"
                            HorizontalAlignment="Right" Command="{Binding LoadCommand}"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
