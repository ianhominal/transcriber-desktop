<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Concentus.Oggfile" Version="1.0.7" />
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="NAudio" Version="2.3.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AudioTranscriber.Core\AudioTranscriber.Core.csproj" />
  </ItemGroup>

  <!-- Fixtures del contrato compartido con el repo web (ADR-13). Se copian al directorio de salida
       para que los tests los lean desde AppContext.BaseDirectory: el fixture TIENE que vivir dentro
       de este repo, si no un clon limpio no lo encuentra y el test falla en cualquier máquina que no
       sea la del dueño. Ver el comentario de PushResponseFixture en SyncDtosTests. -->
  <ItemGroup>
    <Content Include="Fixtures\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
